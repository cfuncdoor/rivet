{
  "$schema": "https://raw.githubusercontent.com/cfuncdoor/rivet/main/rivet.schema.json",
  "package": {
    "name": "cmake-mini-app",
    "version": "0.1.0",
    "standard": "c++17"
  },
  "dependencies": {
    "mini": {
      "path": "./mini",
      "adapter": {
        "tool": "cmake",
        "targets": ["mini"],
        "options": {
          "BUILD_SHARED_LIBS": "OFF"
        }
      },
      "package": {
        "name": "mini",
        "version": "0.1.0"
      }
    }
  }
}
