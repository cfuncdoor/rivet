{
  "$schema": "https://raw.githubusercontent.com/cfuncdoor/rivet/main/rivet.schema.json",
  "package": {
    "name": "cmake-zlib-demo",
    "version": "0.1.0",
    "standard": "c++17"
  },
  "dependencies": {
    "zlib": {
      "git": "https://github.com/madler/zlib.git",
      "tag": "v1.3.1",
      "adapter": {
        "tool": "cmake",
        "options": {
          "BUILD_SHARED_LIBS": "OFF"
        }
      },
      "package": {
        "name": "zlib",
        "version": "1.3.1"
      }
    }
  }
}
